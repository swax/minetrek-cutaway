# Publish only the source tree below. Everything produced during a session is local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY.md
!/pyproject.toml
!/requirements.txt
!/requirements-tested.txt
!/requirements-dev.txt
!/package.json
!/package-lock.json
!/.clang-format
!/.editorconfig
!/.prettierrc.json
!/.prettierignore
!/run.py
!/src/
!/src/**
!/docs/
!/docs/**
!/examples/
!/examples/**
!/scripts/
!/scripts/**
!/tests/
!/tests/**
!/.github/
!/.github/**

__pycache__/
*.py[cod]
*.egg-info/
.env
.env.*
*.exe
*.dll
*.vox
*.rgba
*.mttex
*.mp4
*.m4a
*.zip
*.log
node_modules/
.ruff_cache/
